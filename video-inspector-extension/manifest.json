{
  "manifest_version": 3,
  "name": "视频下载工具-吴文龙",
  "description": "选中页面元素，以网格模态框展示并下载其下所有视频。可在B站私信反馈问题。",
  "version": "1.19.29",
  "homepage_url": "https://space.bilibili.com/3706965849016893?spm_id_from=333.1007.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "contextMenus", "offscreen", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "视频下载工具-吴文龙"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/mux.min.js", "lib/mp4box.all.min.js", "hls-dash.js", "downloader.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
